{
  "name": "@meatcar/agent-hud",
  "version": "0.3.0",
  "description": "Fast statusline HUD for Claude Code",
  "license": "MIT",
  "repository": "github:meatcar/agent-hud",
  "bin": {
    "agent-hud": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "test:stress": "bun test --randomize --seed=20260418 --rerun-each=3",
    "coverage": "bun scripts/validate-coverage.ts",
    "validate:package": "bun scripts/validate-package.ts",
    "lint": "oxlint && fallow",
    "format": "treefmt -q",
    "check": "bun run lint && bun run format --ci",
    "build": "bun build --target=bun --outfile=dist/agent-hud.ts src/index.ts",
    "deploy": "bun run build && cp dist/agent-hud.ts $HOME/.claude/agent-hud.ts",
    "screenshots": "bash scripts/screenshots.sh",
    "bench": "bash bench/run.sh",
    "bench:analyze": "bun run bench/analyze.ts"
  },
  "devDependencies": {
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "latest",
    "fallow": "^3.0.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "5.9.3"
  }
}
